# Copy to .env and adjust. Consumed by the poller/bridge/replay. All values have sensible
# defaults in config.py, so .env is optional for a local run.

# Sensor.Community requires a User-Agent identifying the client. Put a real contact address.
SC_USER_AGENT=sensor-reliability/0.1 (portfolio project; contact: you@example.com)

# Region of interest: Milan. The live filter API takes a centre + radius (km).
SC_AREA_LAT=45.4642
SC_AREA_LON=9.1900
SC_AREA_RADIUS_KM=15

# Poll cadence in seconds; the source refreshes about every 5 minutes.
POLL_INTERVAL_SECONDS=300

# MQTT (Mosquitto). Use localhost from the host; use "mosquitto" from inside compose.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=sc/milan

# Kafka. Use localhost:9094 (EXTERNAL listener) from the host; kafka:9092 from inside compose.
KAFKA_BOOTSTRAP=localhost:9094
KAFKA_TOPIC=sc.readings

# Archive backfill window (used by replay; can also be passed on the command line).
ARCHIVE_START=2026-09-01
ARCHIVE_END=2026-09-07

# Spark streaming job (defaults shown; the compose spark service sets its own paths).
STREAM_WINDOW=1 hour
STREAM_WATERMARK=2 hours
CURATED_DIR=data/curated
CHECKPOINT_DIR=data/checkpoints

# Reference data (OpenAQ, M5). Get a free key at https://openaq.org.
OPENAQ_API_KEY=
